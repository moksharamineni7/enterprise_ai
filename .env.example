# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase Backend
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Frontend (Safe public client variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Storage
SUPABASE_DOCUMENTS_BUCKET=enterprise-documents
MAX_UPLOAD_BYTES=10485760

# AI Limits
AI_MAX_INPUT_CHARS=30000
AI_MAX_OUTPUT_TOKENS=4096
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_REQUESTS_PER_MINUTE=10

# Application Security
INVITATION_TOKEN_TTL_HOURS=72
SIGNED_URL_TTL_SECONDS=300
SESSION_REQUIRE_CONFIRMED_EMAIL=true

# Workflow Engine
WORKFLOW_MAX_STEPS=20
WORKFLOW_MAX_EXECUTION_DEPTH=5
WORKFLOW_EXECUTION_TIMEOUT_MS=30000
